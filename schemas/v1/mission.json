{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localcoder.dev/schemas/mission/v1",
  "title": "LocalCoder Mission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission_id", "project_id", "roadmap_id", "objective", "created_at", "status"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "roadmap_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["PLANNED", "READY", "RUNNING", "PAUSED", "COMPLETED", "FAILED", "BLOCKED"]},
    "scope": {"type": "array", "items": {"type": "string"}},
    "out_of_scope": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "array", "items": {"type": "string"}}
  }
}

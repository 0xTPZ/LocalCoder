{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localcoder.dev/schemas/model-backend/v1",
  "title": "LocalCoder Model Backend",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend_id", "name", "version", "model_id", "capabilities", "local_only", "registered_at", "status"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "backend_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "local_only": {"type": "boolean"},
    "registered_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["AVAILABLE", "DISABLED", "ERROR", "UNLOADED"]},
    "metadata": {"type": "object"}
  }
}

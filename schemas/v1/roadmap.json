{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localcoder.dev/schemas/roadmap/v1",
  "title": "LocalCoder Roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "roadmap_id", "project_id", "title", "created_at", "status", "mission_ids"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "roadmap_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["DRAFT", "ACTIVE", "PAUSED", "COMPLETED", "ARCHIVED"]},
    "mission_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object"}
  }
}

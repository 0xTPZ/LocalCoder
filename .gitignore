# Runtime state, logs, and checkpoints
/var/logs/*
/var/checkpoints/*
/var/state/*
!/var/logs/.gitkeep
!/var/checkpoints/.gitkeep
!/var/state/.gitkeep

# Large/local model artifacts
*.gguf
*.ggml
*.safetensors
*.bin
/models/

# Editor and OS files
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
